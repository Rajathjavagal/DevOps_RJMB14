pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
           
        stage('1. Checkout') {
            steps {
                checkout scm
                echo 'Source code checkout successful'
            }
        }

        stage('2. Build') {
            steps {
                sh 'mvn -B clean compile stage'
                echo 'Java compilation successful'
            }
        }

        stage('3. Test') {
            steps {
                sh 'mvn -B test'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '*/target/surefire-reports/.xml'
                }
            }
        }

        stage('4. Package') {
            steps {
                sh 'mvn -B -DskipTests package'

                archiveArtifacts(
                    artifacts: 'Amazon-Core/target/*.war',
                    fingerprint: true
                )

                echo 'WAR packaging successful'
            }
        }

        stage('5. Deploy & Verify') {
            steps {
                sh '''
                    set -eu

                    WAR_FILE=$(find Amazon-Core/target \
                        -maxdepth 1 -type f -name '*.war' \
                        | head -n 1)

                    test -n "$WAR_FILE"

                    mkdir -p staging

                    cp "$WAR_FILE" staging/

                    test -s "staging/$(basename "$WAR_FILE")"

                    echo "Deployment verified successfully"
                '''

                archiveArtifacts(
                    artifacts: 'staging/*.war',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All five stages completed!'
        }

        failure {
            echo 'FAILURE: Check Jenkins Console Output'
        }

        always {
            echo "Pipeline execution completed"
        }
    }
}
