pipeline {
    agent any

    environment {
        PATH = "/usr/bin:/bin:/opt/homebrew/bin"
    }

    stages {

        stage('compile') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('build') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Deploy') {
            when {
                expression {
                    env.BRANCH_NAME?.contains('release')
                }
            }

            steps {
                echo "Its a release branch and will start deploy the war to tomcat"
            }
        }
    }

    post {
        success {
            echo 'Build success 1'
        }

        failure {
            echo 'Failure in the build'
        }
    }
}
